# Local reference mode works without credentials. It never executes model output.
REPLAYLAB_DATA_DIR=.replaylab
REPLAYLAB_PUBLIC_DEMO=false
REPLAYLAB_SECURE_COOKIE=false
# Live requires inference AND remote sandbox access; select an exact accessible NVIDIA model.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
CONTREE_API_KEY=
CONTREE_BASE_URL=
# Required for Nebius IAM Sandbox authentication; leave blank for legacy access.
NEBIUS_PROJECT_ID=
# Use a prepared image UUID (immutable), built from deploy/sandbox.Dockerfile.
CONTREE_IMAGE=
REPLAYLAB_RUN_TIMEOUT=480
REPLAYLAB_TOKEN_BUDGET=40000
REPLAYLAB_MAX_QUEUED=8
# Optional pricing, USD per million tokens, for estimates only.
NEBIUS_INPUT_RATE=
NEBIUS_OUTPUT_RATE=
