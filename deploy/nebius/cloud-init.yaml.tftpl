#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - git
  - ufw
users:
  - default
  - name: replaylab
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}
write_files:
  - path: /usr/local/sbin/replaylab-first-boot
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      disk=/dev/disk/by-id/virtio-replaylab-data
      for attempt in $(seq 1 60); do
        test -b "$disk" && break
        sleep 1
      done
      test -b "$disk"
      if ! blkid "$disk" >/dev/null 2>&1; then
        mkfs.ext4 -L replaylab-data "$disk"
      fi
      mkdir -p /srv/replaylab
      mountpoint -q /srv/replaylab || mount "$disk" /srv/replaylab
      if ! grep -q '^LABEL=replaylab-data ' /etc/fstab; then
        echo 'LABEL=replaylab-data /srv/replaylab ext4 defaults,nofail 0 2' >> /etc/fstab
      fi
      install -d -o 10001 -g 10001 /srv/replaylab/data
      mkdir -p /srv/replaylab/caddy-data /srv/replaylab/caddy-config
      systemctl enable --now docker
      ufw allow OpenSSH
      ufw allow 80/tcp
      ufw allow 443/tcp
      ufw allow 443/udp
      ufw --force enable
      if ! test -d /srv/replaylab/app/.git; then
        git clone --branch '${git_ref}' https://github.com/SlunkySloth/NVIDIA_HACKATHON.git /srv/replaylab/app
      fi
      if ! test -f /srv/replaylab/runtime.env; then
        install -m 0600 /srv/replaylab/app/.env.example /srv/replaylab/runtime.env
      fi
      if ! test -f /srv/replaylab/hosting.env; then
        cat > /srv/replaylab/hosting.env <<'HOSTING'
      REPLAYLAB_DOMAIN=${domain}
      REPLAYLAB_DATA_ROOT=/srv/replaylab
      REPLAYLAB_ENV_FILE=/srv/replaylab/runtime.env
      HOSTING
      fi
      # Runtime credentials are installed manually after provisioning.
      # No API keys enter cloud-init user data or Terraform state.
      echo 'ReplayLab host prepared. Configure runtime.env, then start deploy/compose.yaml.'
runcmd:
  - [bash, /usr/local/sbin/replaylab-first-boot]
